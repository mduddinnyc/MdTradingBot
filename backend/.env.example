# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/trading_platform

# JWT
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=TradingPlatform
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# TOTP
TOTP_ISSUER=TradingPlatform
